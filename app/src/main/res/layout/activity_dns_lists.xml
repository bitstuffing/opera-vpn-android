<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF111117"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dns_lists_title"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:text="@string/lists_help"
        android:textColor="#FFB0B0B8"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/listsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#FF33333D"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/addLocalListButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#FF33333D"
            android:minHeight="48dp"
            android:text="@string/new_local_list"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/addRemoteListButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#FF33333D"
            android:minHeight="48dp"
            android:text="@string/add_remote_list"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/refreshAllButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF33333D"
        android:minHeight="48dp"
        android:text="@string/refresh_all_lists"
        android:textColor="#FFFFFFFF" />

    <Button
        android:id="@+id/listsBackButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#FF33333D"
        android:minHeight="48dp"
        android:text="@string/back"
        android:textColor="#FFFFFFFF" />

</LinearLayout>
